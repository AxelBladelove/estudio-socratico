{
  "name": "estudio-socratico",
  "version": "2.0.16",
  "private": true,
  "packageManager": "bun@1.3.13",
  "description": "Sistema de estudio socratico para Fundamentos de Programacion en C.",
  "workspaces": [
    "_estudio/installer/ui",
    "_estudio/soporte/vscode/estudio-exercism"
  ],
  "scripts": {
    "installer:restore": "dotnet restore _estudio/installer/EstudioSocratico.Installer.sln",
    "installer:build": "dotnet build _estudio/installer/EstudioSocratico.Installer.sln --configuration Release",
    "installer:test": "dotnet test _estudio/installer/src/EstudioSocratico.Configurator.Tests/EstudioSocratico.Configurator.Tests.csproj --configuration Release",
    "check": "bun run installer:test",
    "engine:build": "./_estudio/soporte/engine/build-engine.cmd",
    "drive:auth": "bun _estudio/soporte/drive/sync-drive.mjs auth",
    "drive:check": "bun _estudio/soporte/drive/sync-drive.mjs check",
    "drive:sync": "bun _estudio/soporte/drive/sync-drive.mjs sync",
    "drive:generate": "bun _estudio/soporte/drive/sync-drive.mjs generate",
    "drive:generate:alejandro": "bun _estudio/soporte/drive/sync-drive.mjs generate --provider alejandro --allow-fallback",
    "drive:sync:alejandro": "bun _estudio/soporte/drive/sync-drive.mjs sync --provider alejandro --allow-fallback",
    "exercism:catalog": "./_estudio/soporte/engine/bin/estudio-engine.exe catalog --repo-root .",
    "exercism:status": "./_estudio/soporte/engine/bin/estudio-engine.exe status --repo-root .",
    "alejandro:gists:publish": "bun _estudio/soporte/gists/publish-alejandro-gists.mjs",
    "alejandro:gists:manifest": "bun _estudio/soporte/gists/inject-alejandro-manifest.mjs",
    "alejandro:semantic": "bun _estudio/soporte/alejandro/semantic-curate-alejandro.mjs",
    "alejandro:icons": "bun _estudio/soporte/alejandro/iconify-icons.mjs",
    "alejandro:semantic:report": "bun _estudio/soporte/alejandro/report-filter-distribution.mjs",
    "alejandro:semantic:apply": "bun _estudio/soporte/alejandro/apply-semantic-results.mjs",
    "validate:v2.5": "bun _estudio/soporte/validaciones/v2.5/validate-v25.mjs"
  },
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AxelBladelove/estudio-socratico.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/AxelBladelove/estudio-socratico/issues"
  },
  "homepage": "https://github.com/AxelBladelove/estudio-socratico#readme"
}
