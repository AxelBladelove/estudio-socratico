{
  "name": "estudio-exercism",
  "displayName": "Estudio Socratico - Exercism",
  "description": "Panel de ejercicios y flujo de compilacion para C dentro de Estudio Socratico.",
  "version": "2.0.16",
  "publisher": "estudio-socratico",
  "license": "MIT",
  "packageManager": "bun@1.3.13",
  "icon": "assets/logo-vscode-extension.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onView:estudioExercism.view",
    "onCommand:estudioExercism.compileActiveCFile",
    "onCommand:estudioExercism.openPanel",
    "onCommand:estudioExercism.openApiKeyConfig",
    "onCommand:estudioExercism.revealApiKeyConfig",
    "onCommand:estudioExercism.analyzeExerciseWithAi",
    "onCommand:estudioExercism.generateAiLogicTests",
    "onUri"
  ],
  "categories": [
    "Education",
    "Other"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "estudioSocratico",
          "title": "Estudio",
          "icon": "assets/logo-vscode-activity.svg"
        }
      ]
    },
    "views": {
      "estudioSocratico": [
        {
          "type": "webview",
          "id": "estudioExercism.view",
          "name": "Ejercicios",
          "icon": "assets/logo-vscode-activity.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "estudioExercism.compileActiveCFile",
        "title": "Compilar archivo C activo",
        "category": "Estudio Socratico",
        "icon": "$(play)"
      },
      {
        "command": "estudioExercism.openPanel",
        "title": "Open",
        "category": "Estudio Socrático",
        "icon": {
          "light": "assets/logo-vscode-command-light.svg",
          "dark": "assets/logo-vscode-command-dark.svg"
        }
      },
      {
        "command": "estudioExercism.testCurrent",
        "title": "Probar ejercicio actual",
        "category": "Estudio Socratico",
        "icon": "$(beaker)"
      },
      {
        "command": "estudioExercism.submitCurrent",
        "title": "Enviar ejercicio actual",
        "category": "Estudio Socratico"
      },
      {
        "command": "estudioExercism.validateCurrent",
        "title": "Validar ejercicio actual",
        "category": "Estudio Socratico"
      },
      {
        "command": "estudioExercism.openApiKeyConfig",
        "title": "Abrir configuracion de API Key",
        "category": "Estudio Socratico"
      },
      {
        "command": "estudioExercism.revealApiKeyConfig",
        "title": "Revelar configuracion de API Key",
        "category": "Estudio Socratico"
      },
      {
        "command": "estudioExercism.analyzeExerciseWithAi",
        "title": "Analizar ejercicio con IA (experimental)",
        "category": "Estudio Socratico"
      },
      {
        "command": "estudioExercism.generateAiLogicTests",
        "title": "Generar tests de logica con IA (experimental)",
        "category": "Estudio Socratico"
      }
    ],
    "keybindings": [
      {
        "command": "estudioExercism.compileActiveCFile",
        "key": "f9",
        "when": "editorTextFocus && resourceLangId == c"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "estudioExercism.openPanel",
          "when": "true",
          "group": "navigation@98"
        },
        {
          "command": "estudioExercism.testCurrent",
          "when": "resourceLangId == c",
          "group": "navigation@99"
        }
      ],
      "view/title": [
        {
          "command": "estudioExercism.openPanel",
          "when": "view.estudioExercism.view",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "bun scripts/check-syntax.mjs",
    "prepare-engine": "bun scripts/prepare-engine.mjs",
    "vscode:prepublish": "bun scripts/prepare-engine.mjs",
    "package": "bunx --bun @vscode/vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.15.0"
  }
}
